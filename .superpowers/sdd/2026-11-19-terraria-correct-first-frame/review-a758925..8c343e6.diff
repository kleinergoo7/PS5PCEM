+                65 => {
+                    if (wc >= 4) { // OpAccessChain
+                        const base = words[i + 3];
+                        if (base < max_id and (sb_var[base] or sb_ptr[base])) sb_ptr[result] = true;
+                    }
+                },
+                61 => {
+                    if (wc >= 4) { // OpLoad
+                        const ptr = words[i + 3];
+                        if (ptr < max_id and (sb_ptr[ptr] or sb_var[ptr])) sb_load[result] = true;
+                    }
+                },
+                else => {},

+    var stored: u32 = 0;
+    i = 5;
+    while (i < words.len) {
+        const wc: usize = words[i] >> 16;
+        if (wc >= 3 and i + wc <= words.len and (words[i] & 0xffff) == 62 and words[i + 1] == position_var) stored = words[i + 2]; // OpStore

+    var i: usize = 5;
+    while (i < words.len) {
+        const wc: usize = words[i] >> 16;
+        const op: u32 = words[i] & 0xffff;
+        if (wc == 0 or i + wc > words.len) { i += 1; continue; }
+        const result = if (wc >= 3) words[i + 2] else 0;
+        if (result < max_id) {
+            switch (op) {
+                59 => {
+                    if (wc >= 4 and words[i + 3] == 12) sb_var[result] = true; // OpVariable StorageBuffer
